rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isDesignatedAdminEmail() {
      return request.auth.token.email in ['ezagency2nd@gmail.com'];
    }
    function isAssignerEmail() {
      return request.auth.token.email in ['prashuchiha34@gmail.com'];
    }
    // signed-in is NOT the same as team member: signup is open, so a
    // stranger can hold a 'pending' account. Anything the whole TEAM may
    // do (but a pending stranger may not) gates on this instead.
    function isTeam() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'worker'];
    }
    /* ---- Tenancy (docs/platform-spec.md, phase 1) ----
       An org is a tenant. Membership is a DOCUMENT, not an email in a
       list: orgs/{orgId}/members/{uid} both proves you belong and names
       the role you hold, so adding someone becomes a write instead of a
       deploy - which is the whole reason ADMIN_EMAILS above cannot come
       along to a product. Everything an org owns hangs beneath it, and
       that is what lets one shape - "are you a member of THIS org" -
       guard the entire tree.
       This block is ADDITIVE on purpose: these collections are new and
       nothing reads them yet, so today's app cannot notice them and the
       live agency keeps working while the model is built beside it. */
    function isOrgMember(orgId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function orgRoleId(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.roleId;
    }
    function isOrgOwner(orgId) {
      return isOrgMember(orgId) && orgRoleId(orgId) == 'owner';
    }
    // whoever the org doc names as its founder. The one identity allowed
    // to seat itself - and only while no roster exists to say otherwise.
    function isOrgFounder(orgId) {
      return request.auth != null
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid;
    }

    // Which org a person belongs to, kept somewhere they can read it
    // WITHOUT already knowing the answer - orgs are not enumerable, so a
    // signed-in client needs one pointer about itself to find its tenant.
    // Self-asserted on purpose, and it authorizes nothing: the org's own
    // members doc is what proves membership, so a pointer naming an org
    // you do not belong to simply gets you refused by that org.
    match /memberOf/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /orgs/{orgId} {
      allow get: if isOrgMember(orgId);
      // never enumerable, not even by a member: a tenant list is a
      // customer list, and the doc id is the only way in
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is int;
      // ownerUid is frozen: the founding seat below trusts it, so an
      // owner who could move it could hand that key to anyone
      allow update: if isOrgOwner(orgId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      // deleting a tenant is not a client action at any role
      allow delete: if false;

      match /members/{uid} {
        allow read: if isOrgMember(orgId);
        // Three ways a seat is filled, and no fourth.
        // 1. an owner seats anyone.
        // 2. the founding seat: a new org has no roster, so nobody could
        //    write one. The founder may seat THEMSELVES as owner, once -
        //    never anyone else, and never at any other role.
        // 3. an invited person seats THEMSELVES, by naming the token in
        //    the seat itself - same shape the users/{uid} signup rule
        //    already uses. The token must still be unburned, unexpired,
        //    point at THIS org, and grant exactly the role being claimed,
        //    so a holder cannot upgrade themselves on the way in.
        allow create: if isOrgOwner(orgId)
          || (isOrgFounder(orgId) && uid == request.auth.uid
              && request.resource.data.roleId == 'owner')
          || (request.auth != null && uid == request.auth.uid
              && request.resource.data.invite is string
              && exists(/databases/$(database)/documents/orgs/$(orgId)/invites/$(request.resource.data.invite))
              && get(/databases/$(database)/documents/orgs/$(orgId)/invites/$(request.resource.data.invite)).data.roleId == request.resource.data.roleId
              && get(/databases/$(database)/documents/orgs/$(orgId)/invites/$(request.resource.data.invite)).data.usedBy == null
              && get(/databases/$(database)/documents/orgs/$(orgId)/invites/$(request.resource.data.invite)).data.expiresAt is int
              && get(/databases/$(database)/documents/orgs/$(orgId)/invites/$(request.resource.data.invite)).data.expiresAt > request.time.toMillis());
        allow update, delete: if isOrgOwner(orgId);
      }

      match /roles/{roleId} {
        // every member reads the roles - the UI needs the permission
        // rows to know which buttons exist - but only an owner shapes them
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgOwner(orgId);
      }

      // Seats offered but not yet taken. The doc id IS the capability -
      // an unguessable token in a link an owner hands out - the same
      // pattern invites/{token} and clientReviews/{token} already use.
      // Living UNDER the org is what makes it affordable: the tenant
      // comes from the PATH, so listing costs one membership check no
      // matter how many invites exist, where a top-level collection
      // would have cost two document reads per row and blown the
      // ten-read query cap at the fifth invite. It also deletes a check
      // entirely - nothing needs to ask whether a token points at this
      // org, because a token that did not could not be at this path.
      // ---- the work model (docs/platform-spec.md, phase 2) ----
      // Everything an org owns lives UNDER it, so tenancy is structural
      // rather than a field someone has to remember to filter on: a query
      // literally cannot cross tenants, and listing costs ONE membership
      // check no matter how many rows come back. The invites collection
      // above learned this the expensive way.

      // The schema an org designs for itself: which fields a kind of work
      // has, which statuses it moves through, which blueprint it rides.
      match /itemTypes/{typeId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgOwner(orgId);
      }

      // The work itself.
      // KNOWINGLY PERMISSIVE, AND TIME-BOXED: any member may write any
      // item here, because the decision about what a person MAY change
      // lives in js/item-engine.js, and a rule is not a place that can
      // run it - rules allow one return statement and ten document reads.
      // Phase 3 moves itemCommit() into a callable and narrows this to
      // the server, at which point the client loses write access here
      // entirely. Until then this is the same trusted-team tradeoff
      // nodeRuns and campaigns already document, with one real
      // difference: every change now leaves an event beside it, so what
      // is not yet PREVENTABLE is at least ATTRIBUTABLE.
      match /items/{itemId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgMember(orgId);
      }

      // The log. Append-only, forever - not even an owner rewrites what
      // happened, which is the entire reason it can be trusted as an
      // audit trail and as the trigger surface automations read.
      // An actor may only write events in their own name.
      match /events/{eventId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.at is int
          && request.resource.data.verb is string;
        allow update, delete: if false;
      }

      match /invites/{token} {
        // the holder has to see what a link offers before accepting it,
        // and they are not a member yet - so this one is open to any
        // signed-in account. Listing stays owner-only: a get needs the
        // unguessable id, a list would hand over every id at once.
        allow get: if request.auth != null;
        allow list: if isOrgOwner(orgId);
        allow create: if isOrgOwner(orgId)
          && request.resource.data.roleId is string
          && request.resource.data.usedBy == null
          && request.resource.data.expiresAt is int;
        // burning it: the holder stamps THEMSELVES on it, once, and may
        // touch nothing else - not the role it grants, and never twice
        allow update: if request.auth != null
          && resource.data.usedBy == null
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']);
        allow delete: if isOrgOwner(orgId);
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // signup is INVITE-ONLY: a pending account can only be born naming a
      // live, unused invite doc. Anyone can still create a Firebase Auth
      // login, but without the link it can never become a member here.
      allow create: if request.auth != null && request.auth.uid == uid
        && ((request.resource.data.role == 'pending'
             && request.resource.data.invite is string
             && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
             && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedBy == null
             // links go stale on their own: 24 hours from minting
             && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.expiresAt is int
             && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.expiresAt > request.time.toMillis())
            || (request.resource.data.role == 'admin' && isDesignatedAdminEmail()));
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid && request.resource.data.role == 'admin' && isDesignatedAdminEmail()) ||
        (request.auth.uid == uid && request.resource.data.role == 'worker' && resource.data.role == 'admin' && !isDesignatedAdminEmail()) ||
        // finishing (or resending) email verification after signup: only
        // reachable while still unverified, role can't move in the same
        // write, and nothing outside the three verification fields may -
        // never a path to granting yourself a different role
        (request.auth.uid == uid
         && 'emailVerified' in resource.data && resource.data.emailVerified == false
         && request.resource.data.role == resource.data.role
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'verifyCode', 'verifyCodeAt']))
      );
      allow delete: if request.auth != null && isAdmin();
    }
    match /appState/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isAssignerEmail());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && isAdmin();
    }
    // Company directory for @mention autocomplete: every signed-in account
    // may read the whole list (names + emails only), but can write only its
    // own entry. Exists because workers can't read appState.
    // Admins may also write anyone's entry: an admin session backfills the
    // whole team from appState so colleagues are mentionable before their
    // own next sign-in.
    match /directory/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // In-app notifications (task-comment @mentions). Anyone signed in may
    // notify; only the target - a member by uid, or any admin via the
    // toRole:"admin" fan-in doc - may read it or mark it read.
    match /notifications/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        (resource.data.toRole == 'admin' && isAdmin())
      );
      // the target may mark it read, or answer a pending hand-off once -
      // never rewrite its content or flip a decided offer back to pending
      allow update: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        (resource.data.toRole == 'admin' && isAdmin())
      ) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
         && resource.data.status == 'pending'
         && request.resource.data.status in ['accepted', 'declined'])
      );
      allow delete: if request.auth != null && (resource.data.toUid == request.auth.uid || isAdmin());
    }
    match /assignments/{id} {
      allow read: if request.auth != null && (resource.data.toUid == request.auth.uid || isAdmin() || isAssignerEmail());
      // workers may also create assignments addressed to THEMSELVES - that
      // is how accepting a comment-tag hand-off lands on their own queue
      allow create: if request.auth != null && (isAdmin() || isAssignerEmail()
        || request.resource.data.toUid == request.auth.uid);
      // the assignee's own updates are progress-only: they can finish,
      // undo, comment and stamp seen - never re-address the task to
      // someone else or rewrite what was asked of them
      allow update: if request.auth != null && (
        isAdmin() || isAssignerEmail() ||
        (resource.data.toUid == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['done', 'doneAt', 'ack', 'comment', 'commentAt', 'seenAt']))
      );
      // the assigner's edit flow deletes rows it removes from a thread -
      // without this, any edit that drops a task fails wholesale for them
      allow delete: if request.auth != null && (isAdmin() || isAssignerEmail());
    }
    // Campaigns: the baton-pass pipeline. Only admins create, shape or
    // delete them; everyone assigned to any stage may read the whole track
    // and move the baton (stage-owner checks run app-side in a transaction
    // - same trusted-team tradeoff the assignments collection already makes).
    match /campaigns/{id} {
      allow read, update: if request.auth != null
        && (isAdmin() || request.auth.uid in resource.data.memberUids);
      allow create, delete: if request.auth != null && isAdmin();
    }
    // Saved chains (stages + default owners): admin tooling only.
    match /campaignTemplates/{id} {
      allow read, create, update, delete: if request.auth != null && isAdmin();
    }
    // Workflow blueprints: the drawings only admins shape; the whole team
    // may read them (the runs board shows which track a task rides). Runs
    // never read these live - each run carries its own frozen snapshot.
    match /blueprints/{id} {
      allow read: if request.auth != null && isTeam();
      allow create, update, delete: if request.auth != null && isAdmin();
      // Immutable publish history: each publish records its version here
      // once, and nothing may ever rewrite or delete a past version - not
      // even an admin. Restore only COPIES a version into a new draft.
      match /versions/{ver} {
        allow read: if request.auth != null && isTeam();
        allow create: if request.auth != null && isAdmin();
        allow update, delete: if false;
      }
    }
    // Workflow runs: one real task riding a FROZEN copy of a blueprint.
    // Only admins start or kill runs. Any team member may advance one, but
    // through an allowlist of progress fields only - blueprintSnapshot and
    // task are written once at creation and this is what keeps a client
    // (buggy or hostile) from ever rewriting the track mid-flight.
    // nodeRunIds rides in the allowlist because transactions can't query:
    // the run doc carries refs to its nodeRuns and an advance appends the
    // attempts it created.
    match /runs/{id} {
      allow read: if request.auth != null && isTeam();
      allow create, delete: if request.auth != null && isAdmin();
      // the status list pins team writes to the engine's own vocabulary:
      // "cancelled" is an admin verdict, not an outcome an advance can
      // produce, so only an admin may write it
      allow update: if request.auth != null && (isAdmin() ||
        (isTeam() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'activeNodeIds', 'hops', 'completedAt', 'nodeRunIds'])
          && request.resource.data.status in ['running', 'completed', 'failed']));
    }
    // One node's story inside one run. The team writes these freely while
    // advancing (same trusted-team tradeoff the assignments collection
    // documents); the frozen truth a run executes lives on the run doc,
    // which the allowlist above protects.
    match /nodeRuns/{id} {
      allow read, create, update: if request.auth != null && isTeam();
      allow delete: if request.auth != null && isAdmin();
    }
    // Invite links: the doc id IS the capability (same pattern as
    // clientReviews below) - an unguessable token in a link the admin
    // hands out. The users create rule above is what makes signup closed;
    // this collection is the ledger. The new account burns its invite
    // exactly once, about itself - never anyone else's, never twice.
    match /invites/{token} {
      allow get: if true;
      allow list: if request.auth != null && isAdmin();
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedBy', 'usedAt', 'usedEmail', 'usedName']);
    }
    // Client review links: the doc id IS the capability - an unguessable
    // token carried in a link, opened with no login. Anyone holding it may
    // read that one doc and answer once: only the decision fields, only
    // while still pending. The team creates them signed-in; querying the
    // collection stays signed-in-only so tokens can't be enumerated.
    match /clientReviews/{token} {
      allow get: if true;
      // listing is TEAM-only: signup is open, so a merely signed-in
      // 'pending' stranger must not be able to harvest tokens
      allow list: if request.auth != null && isTeam();
      allow create: if request.auth != null && isTeam();
      allow update: if resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'changes']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.decidedAt is int
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'comment', 'decidedAt']);
      allow delete: if request.auth != null && isAdmin();
    }
    // Email summaries: the app queues a message here; the Trigger Email
    // extension (admin SDK, bypasses these rules) delivers it and stamps
    // delivery state back on the doc, which the requester watches.
    match /mail/{id} {
      // workers may only queue mail addressed to themselves; admins to
      // anyone. The key allowlists stop cc/bcc/replyTo riding along and
      // turning the project's sender into anyone's relay.
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.resource.data.to.size() == 1
         && request.resource.data.to[0] == request.auth.token.email
         && request.resource.data.keys().hasOnly(['to', 'message', 'summary'])
         && request.resource.data.message.keys().hasOnly(['subject', 'html']))
      );
      // reading back your own request is what powers the sent/failed toast
      allow read: if request.auth != null
        && resource.data.summary.requestedBy == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
